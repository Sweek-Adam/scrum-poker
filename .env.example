# Supabase — Dashboard > ton projet > Settings > API Keys
# https://supabase.com/dashboard/project/_/settings/api-keys

# Onglet "Data API" (ou "API Keys"), champ "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Onglet "API Keys" > "Publishable key" (commence par sb_publishable_).
# L'ancienne clé "anon" (eyJhbGciOi...) fonctionne aussi : elle est maintenant
# rangée sous l'onglet "Legacy API Keys". Les deux sont publiques par
# conception — elles sont livrées dans le bundle JS du navigateur.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
